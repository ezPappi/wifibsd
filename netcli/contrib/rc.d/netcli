#!/bin/sh
#
# Apply the netcli startup configuration (/etc/netcli/startup.yaml).
# Enable with netcli=YES in /etc/rc.conf. netcli replaces the ifconfig_*,
# defaultroute, npf and dhcpcd settings in rc.conf: leave those unset.
#
# PROVIDE: netcli
# REQUIRE: network
# BEFORE: NETWORKING

$_rc_subr_loaded . /etc/rc.subr

name="netcli"
rcvar=$name
command="/usr/local/sbin/netcli"
start_cmd="netcli_start"
stop_cmd=":"

netcli_start()
{
	echo "Applying netcli startup configuration."
	${command} ${netcli_flags} apply
}

load_rc_config $name
run_rc_command "$1"
